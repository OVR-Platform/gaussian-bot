# Environment defaults (safe to commit). Copy to `.env` and edit.
# Never put real secrets in this file.

# Which renderer backend to use (unset = none). See docs/adr/0001.
# GAUSSIAN_ROBOT_RENDERER=gsplat

# Which VLM backend to use (unset = none).
# GAUSSIAN_ROBOT_VLM=vllm
# GAUSSIAN_ROBOT_VLM_MODEL=
# GAUSSIAN_ROBOT_VLM_BASE_URL=

# Where scene files live (under data/).
# GAUSSIAN_ROBOT_DATA_DIR=./data
